{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with CTest enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "validation",
      "displayName": "Validation (Release + Vulkan WSI + Khronos Validation)",
      "description": "Release build with offscreen Vulkan WSI and Khronos validation tests enabled.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-validation",
      "cacheVariables": {
        "SS2_TEST_WINDOW": "ON",
        "SS2_TEST_VALIDATION": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (Clang Debug + ASan + UBSan)",
      "description": "Debug build with Clang AddressSanitizer and UndefinedBehaviorSanitizer across all tests.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "BUILD_TESTING": "ON",
        "SS2_TEST_WINDOW": "ON",
        "SS2_TEST_VALIDATION": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "validation",
      "configurePreset": "validation"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "validation",
      "configurePreset": "validation",
      "environment": {
        "SDL_VIDEO_DRIVER": "offscreen"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "environment": {
        "SDL_VIDEO_DRIVER": "offscreen",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
